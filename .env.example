PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated browser origins allowed for credentialed API calls.
# CLIENT_URL's origin is always allowed automatically.
ALLOWED_CLIENT_ORIGINS=https://jobpilot-ui.onrender.com
SESSION_COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://jobpilot:replace-me@localhost:5432/jobpilot

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_AUDIENCE=https://<public-api-host>/api/gmail/webhook
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=<push-service-account>@<project-id>.iam.gserviceaccount.com

# Set this to the URL of your RabbitMQ broker.
RABBITMQ_URL=amqp://jobpilot:jobpilot-local-only@localhost:5672

OPENAI_API_KEY=
